	local frame = script.Parent
	local Button = frame:IsA("GuiButton") and frame or nil
	
	-- Search for the BoolValue in the frame, its parent, or the ScreenGui
	local flag = frame:FindFirstChild("PageShown")
		or frame.Parent:FindFirstChild("PageShown")
		or (frame.Parent:FindFirstChildOfClass("ScreenGui") or frame):FindFirstChild("PageShown")
	
	local function apply(shown)
		frame.Visible = shown
		frame.Interactable = shown
		if Button then
			Button.Active = shown
			Button.Selectable = shown
			Button.Interactable = shown
		else
			frame.Active = shown
		end
	end
	
	if not flag then
		warn("PageShown BoolValue not found for " .. frame:GetFullName())
		return
	end
	
	apply(flag.Value)
	flag:GetPropertyChangedSignal("Value"):Connect(function()
		apply(flag.Value)
	end)
end;
