local function C_61()
local script = G2L["61"];
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UIS = game:GetService("UserInputService")
	
	local player = Players.LocalPlayer
	
	local noclip = false
	local connection
	local originalCollision = {}
	
	local function saveCollisionState(char)
		originalCollision = {}
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				originalCollision[part] = part.CanCollide
			end
		end
	end
	
	local function setCharacterCollision(char, state)
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = state
			end
		end
	end
	
	local function restoreCollision(char)
		for part, state in pairs(originalCollision) do
			if part and part.Parent then
				part.CanCollide = state
			end
		end
	end
	
	local function startNoclip(char)
		saveCollisionState(char)
		setCharacterCollision(char, false)
	
		connection = RunService.Stepped:Connect(function()
			if player.Character then
				setCharacterCollision(player.Character, false)
			end
		end)
	end
	
	local function stopNoclip(char)
		if connection then
			connection:Disconnect()
			connection = nil
		end
		restoreCollision(char)
	end
	
	local function toggle()
		noclip = not noclip
		local char = player.Character
		if not char then return end
	
		if noclip then
			startNoclip(char)
		else
			stopNoclip(char)
		end
	end
	
	-- Button support
	if script.Parent:IsA("GuiButton") then
		script.Parent.MouseButton1Click:Connect(toggle)
	end
	
	-- KEYBIND (C)
	UIS.InputBegan:Connect(function(input, gp)
		if gp then return end
		if input.KeyCode == Enum.KeyCode.C then
			toggle()
		end
	end)
	
	-- Fix on respawn
	player.CharacterAdded:Connect(function(char)
		task.wait(0.5)
		if noclip then
			startNoclip(char)
		end
	end)
end;
