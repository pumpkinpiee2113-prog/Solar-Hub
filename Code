	-- Pages (ScrollingFrame)
	local pages = button.Parent
	while pages and pages.Name ~= "Pages" do
		pages = pages.Parent
	end
	
	if not pages then
		warn("Pages not found above " .. button:GetFullName())
		return
	end
	
	-- Main frame: Pages' parent
	local main = pages.Parent
	if not main then
		warn("Pages has no parent")
		return
	end
	
	local updatePage = main:FindFirstChild("UpdatePage")
	if not updatePage then
		warn("UpdatePage not found under " .. main:GetFullName())
		return
	end
	
	local flag = updatePage:FindFirstChild("PageShown")
	if not flag then
		warn("PageShown not found under " .. updatePage:GetFullName())
		return
	end
	
	local function activate()
		for _, other in ipairs(main:GetDescendants()) do
			if other:IsA("BoolValue") and other.Name == "PageShown" and other ~= flag then
				other.Value = false
			end
		end
		flag.Value = true
		print("[UpdatePageButton] fired, PageShown = " .. tostring(flag.Value))
	end
	
	button.Activated:Connect(activate)
end;
